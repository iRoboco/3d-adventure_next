// Материал анимированной воды: прокрутка UV в кастомном шейдере.
// Render-state (blend/depth/cull) задаётся в коде ChunkManager::buildWaterVisualNode,
// чтобы поведение совпадало с прежним built-in материалом воды.
material Water
{
    technique normal
    {
        pass 0
        {
            shader
            {
                vertexShader = custom/water_vs
                fragmentShader = custom/water_fs

                // Текстура u_tex0 НЕ задаётся здесь: parseSampler применил бы
                // LINEAR-фильтрацию к общему атласу и сломал пиксельность.
                // Привязка _terrainAtlas (с NEAREST) делается в коде —
                // ChunkManager::buildWaterVisualNode.
            }
        }
    }
}
